<launch>
  <arg name="trajectories_file" default="$(find exosuit_teleop)/config/trajectories.yaml"/>
  <arg name="transition_duration_s" default="3.0"/>
  <arg name="left_serial" default="/dev/ttyACM0"/>
  <arg name="right_serial" default="/dev/ttyACM1"/>
  <arg name="start_arms" default="true"/>
  <arg name="start_grippers" default="true"/>
  <arg name="start_recording" default="true"/>
  <node pkg="exosuit_teleop" type="exosuit_teleop_node.py" name="exosuit_teleop"
        if="$(arg start_arms)" output="screen" required="true" clear_params="true">
    <rosparam command="load" file="$(find exosuit_teleop)/config/joint_mapping.yaml"/>
    <rosparam command="load" file="$(arg trajectories_file)"/>
    <param name="transition_duration_s" type="double" value="$(arg transition_duration_s)"/>
    <param name="left_serial" value="$(arg left_serial)"/>
    <param name="right_serial" value="$(arg right_serial)"/>
  </node>
  <node pkg="exosuit_teleop" type="grip_state_publisher.py" name="grip_state_publisher"
        if="$(arg start_grippers)" output="screen" required="true" clear_params="true"/>
  <node pkg="exosuit_teleop" type="isaac_record_trigger.py" name="isaac_record_trigger"
        if="$(arg start_recording)" output="screen" required="true" clear_params="true"/>
</launch>
