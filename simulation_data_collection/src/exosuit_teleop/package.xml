<?xml version="1.0"?>
<package format="2">
  <name>exosuit_teleop</name>
  <version>0.1.0</version>
  <description>Open-loop ExoSuit arm teleoperation for the KUAVO simulation.</description>
  <maintainer email="maintainers@example.org">Control ExoSuit maintainers</maintainer>
  <license>See upstream repository</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>dynamic_biped</depend>
  <!-- Hardware Python packages are installed separately from the pinned sources in README.md. -->
  <exec_depend>joyconrobotics</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>roslaunch</test_depend>
</package>
