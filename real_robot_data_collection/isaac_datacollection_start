#!/bin/bash

SESSION="isaac_datacollection"
WORKSPACE_DIR="$(cd "$(dirname "$0")" && pwd)"

ROS_MASTER="http://192.168.1.112:11311"
ROS_IP_ADDR="192.168.1.112"

if [ ! -f "$WORKSPACE_DIR/devel/setup.bash" ]; then
    echo "ERROR: devel/setup.bash not found in $WORKSPACE_DIR"
    echo "Place this script in the ROS1 workspace root."
    exit 1
fi

if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "tmux session '$SESSION' already exists. Attaching..."
    tmux attach -t "$SESSION"
    exit 0
fi

tmux new-session -d -s "$SESSION" -n ros_exosuit
tmux split-window -h -t "$SESSION":0
tmux split-window -v -t "$SESSION":0.0
tmux split-window -v -t "$SESSION":0.1
tmux select-layout -t "$SESSION":0 tiled

tmux send-keys -t "$SESSION":0.0 "
cd '$WORKSPACE_DIR'
source devel/setup.bash
export ROS_MASTER_URI=$ROS_MASTER
export ROS_IP=$ROS_IP_ADDR
unset ROS_HOSTNAME
roscore
" C-m

tmux send-keys -t "$SESSION":0.1 "
cd '$WORKSPACE_DIR'
source devel/setup.bash
export ROS_MASTER_URI=$ROS_MASTER
export ROS_IP=$ROS_IP_ADDR
unset ROS_HOSTNAME
sleep 3
roslaunch servo_angle_publisher servo_angle.launch
" C-m

tmux send-keys -t "$SESSION":0.2 "
cd '$WORKSPACE_DIR'
source devel/setup.bash
export ROS_MASTER_URI=$ROS_MASTER
export ROS_IP=$ROS_IP_ADDR
unset ROS_HOSTNAME
sleep 5
roslaunch grip_state_publisher grip_state.launch
" C-m

tmux send-keys -t "$SESSION":0.3 "
cd '$WORKSPACE_DIR'
source devel/setup.bash
export ROS_MASTER_URI=$ROS_MASTER
export ROS_IP=$ROS_IP_ADDR
unset ROS_HOSTNAME
sleep 5
roslaunch data_bag_recorder isaac_record_trigger.launch
" C-m

tmux select-pane -t "$SESSION":0.0
tmux attach -t "$SESSION"
